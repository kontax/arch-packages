#!/bin/sh
#
# Confirmed on real hardware: toggling this always ended up "on" no matter
# which state it started in. `pkill -RTMIN+4 -x waybar` never matched -
# waybar's actual process/comm name under Nix is `.waybar-wrapped` (the
# wrapper script), not literally `waybar` - so it always exited 1, and the
# old `toggle() { [ -e "$marker" ] && off || on }` treated any failure of
# `off` as a reason to *also* run `on` right after (`A && B || C` runs C
# whenever B fails, not just when A is false - it isn't a real if/else).
# Dropped -x (substring match still finds `.waybar-wrapped`) and switched
# toggle to a real if/else so a future failure in on()/off() can't
# silently run the other branch too.
#
# Also: `light -S 100` doesn't exist - MIGRATION.md's light->acpilight
# swap kept the old CLI syntax here by mistake, acpilight's binary is
# actually `xbacklight` with `-set PERCENT`. And `wluma` (auto-brightness)
# was never wired up as a systemd service anywhere in this flake despite
# being installed as a package - "Unit wluma.service not found" every
# time - dropped rather than left silently failing; wiring up a working
# wluma service is a separate task if still wanted.
marker="/tmp/waybar-movie"

show() {
    if [ -e "$marker" ]; then
        printf "{\"text\": \" <span face='Font Awesome 7 Free,Font Awesome 7 Brands' foreground='#928374'></span> \", \"class\": \"on\"}\n"
    else
        printf "{\"text\": \" <span face='Font Awesome 7 Free,Font Awesome 7 Brands' foreground='#928374'></span> \", \"class\": \"off\"}\n"
    fi
}

on() {
    touch "$marker"
    xbacklight -set 100
    pkill -RTMIN+4 waybar
}

off() {
    rm -f "$marker"
    pkill -RTMIN+4 waybar
}

toggle() {
    if [ -e "$marker" ]; then
        off
    else
        on
    fi
}

case "$1" in
    on)     on ;;
    off)    off ;;
    toggle) toggle ;;
    '')     show ;;
esac
