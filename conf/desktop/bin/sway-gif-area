#!/bin/sh

pkill -x wf-recorder -SIGINT

[ $? -ne 0 ] && {
    systemctl --user stop sway-inactive-window-transparency.service

    path="/tmp/record_$(date +%s)"
    notify-send -t 2000 'GIF recording' 'Select an area to start the recording...'
    geometry="$(slurp)"
    # Cancelling the selection (Escape) exits slurp with a non-zero status
    # but this script never checked it - an empty $geometry still got
    # passed to `wf-recorder -g`, which falls back to recording the whole
    # output instead of erroring. Confirmed live: an accidental Escape
    # left wf-recorder running unbounded for 54 minutes, unnoticed until
    # the recording indicator turned up and had to be tracked down.
    if [ -z "$geometry" ]; then
        systemctl --user start sway-inactive-window-transparency.service
        exit 1
    fi
    # -x (exact match) never works here: NixOS wraps the waybar binary, so
    # the running process's comm is ".waybar-wrapped", not "waybar". Plain
    # substring matching also isn't safe: it collides with any other
    # waybar-* helper that happens to be running (e.g. waybar-yubikey, a
    # persistent loop) and would kill that instead/as well - confirmed live
    # this exact collision took down waybar-updates.service (see its own
    # comment). -f anchored on the literal install path is exact: argv[0]
    # for the real waybar process is still the unwrapped ".../bin/waybar"
    # path (only comm is rewritten), and the trailing $ excludes every
    # "bin/waybar-something" helper.
    { sleep 1 && pkill -RTMIN+3 -f '/bin/waybar$'; } &
    wf-recorder -g "$geometry" -f "$path.mkv"
    pkill -RTMIN+3 -f '/bin/waybar$'
    notify-send -t 2000 'GIF recording' "Encoding to GIF format..."
    ffmpeg -i "$path.mkv" -vf "fps=15,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" "$path.gif"
    wl-copy -t image/gif < "$path.gif"
    notify-send 'GIF recording' "Recording is ready: $path.gif"

    systemctl --user start sway-inactive-window-transparency.service
} &
