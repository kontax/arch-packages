#!/usr/bin/env bash
#
# Name: dmenu-nmcli
# Author: James Coulson
#
# A script that generates a dmenu menu using nmcli to list and 
# connect to network devices.
#
# Inspired by rofi-bluetooth (https://github.com/nickclyde/rofi-bluetooth)
# and rofi-wifi-menu (https://github.com/zbaylin/rofi-wifi-menu)
#
# Depends on:
#   Arch repositories: rofi, nmcli, libnotify

# Logging
set -uo pipefail
trap 's=$?; notify-send -i "$0: Error on line "$LINENO": $BASH_COMMAND"; exit $s' ERR


# Globals
OUT=""
SSID=""
DIVIDER="---------"
MANUAL="Manual Connection"
FIELDS="IN-USE,SSID,BARS,SECURITY"
RAW_APS=$(nmcli --fields $FIELDS dev wifi list --rescan yes)
# Column widths must come from the header row, not a data row - confirmed
# live, this used to sample the first *AP* line instead, and a multi-word
# SSID there (e.g. "DIRECT-2D-HP ENVY 6000 series") desyncs the fixed
# widths for every row, truncating SSIDs and misreading the security
# column entirely for the rest of the menu. Header labels (IN-USE, SSID,
# BARS, SECURITY) are always single tokens, so they're a stable reference
# regardless of which AP happens to be first.
#
# The IN-USE and SSID header widths are merged into one FIELDWIDTHS group
# (in-use width replaced by 1): the sed below collapses each row's real
# IN-USE column (a "*" or blank, padded to that header width) down to
# just its one marker character glued directly onto the SSID text, so
# get_column_location's "SSID is field 1" offset (it treats IN-USE as
# folded into SSID, not its own field) only lines up if FIELDWIDTHS
# matches that same collapse - confirmed live: without merging here,
# every field boundary after IN-USE was off by (header IN-USE width - 1)
# characters, truncating SSIDs and reading security off a garbage offset.
read -r inuse_width ssid_width bars_width security_width <<< "$(echo "$RAW_APS" \
    | head -n 1 | grep -Po '\S+\s*' \
    | awk '{printf "%d ", length($0)}'
)"
WIDTHS="$((1 + ssid_width)) $bars_width $security_width"
APS=$(echo "$RAW_APS" \
            | tail -n +2 \
            | sed 's#^\(.\)\s*#\1#' \
            | sed '/^ --/d'
)
# Multiple APs (mesh/extenders, or just neighbouring APs on the same
# network) show up as separate lines with an identical SSID - nmcli
# already sorts by signal strength, so keeping the first line per SSID
# keeps the strongest one and drops the rest. Uses the same FIELDWIDTHS
# convention as get_ssid() below ($1 is SSID once the leading in-use
# marker's been collapsed by the sed above), so it stays consistent with
# how every other field lookup here already parses these lines.
APS=$(echo "$APS" | awk -v FIELDWIDTHS="$WIDTHS" '
    { ssid = $1; gsub(/^[ *]+|[ ]+$/, "", ssid); if (!seen[ssid]++) print $0 }
')

# A lock/unlock glyph reads faster than squinting at "WPA2" vs blank, but
# create_connection further down still needs the real security *type*
# (WPA/WEP vs 802.1X vs open) to decide how to prompt for credentials -
# so this is a display-only copy, never used for that decision. Inconsolata
# Nerd Font Mono (forced for this menu below, for the same column-alignment
# reason) covers both U+F023/U+F09C directly, and since it's the only font
# in play here there's no risk of the cross-font PUA collisions that bit
# waybar's icons earlier - see git log for that whole saga.
DISPLAY_APS=$(echo "$APS" | awk -v FIELDWIDTHS="$WIDTHS" -v lock=$'' -v unlock=$'' '
    { security = $3; gsub(/^ +| +$/, "", security); icon = (security == "") ? unlock : lock;
      printf "%s%s  %s\n", $1, $2, icon }
')


# Use libnotify to send any errors that occur and show the menu again
notify_error() {

    # Check if the output contains the word Error
    if [[ "$OUT" =~ "Error" ]]; then

        # Send the message
        echo "$OUT" 1>&2
        notify-send "NetworkManager" "$OUT"

        # Delete any SSID that may have been created with errors
        nmcli con delete "$SSID"

        # Reset the global variables
        OUT=""
        SSID=""

        # Go back to the main menu
        show_menu
    fi
}

# Gets the field number of the specified column for matching
# This ignores the IN-USE column as that's prepended to the SSID
get_column_location() {
    local match
    local field_num

    match=$1
    field_num=$(echo -e "$FIELDS" | \
        awk 'BEGIN{FS=","}{for(i=1;i<=NF;++i)
            {if($i == "'$match'") print i-1}}')
    return $field_num
}

# Pull out the SSID from a chosen row. $row is one of $APS's own lines
# verbatim (rofi returns back exactly what it was given), not re-derived
# by searching $APS again - BSSID used to be needed for that lookup, but
# once AP lists this uses are deduped by SSID (above), SSID alone is
# already a unique key, so there's nothing left that needs BSSID for.
get_ssid() {
    local row
    local ssid_loc

    row=$1

    get_column_location "SSID"
    ssid_loc=$?
    SSID=$(echo "$row" \
        | awk -v FIELDWIDTHS="$WIDTHS" "{print \$$ssid_loc}" \
        | sed 's/^\*//;s/^ *//;s/ *$//' \
    )
    echo $SSID
}

# Pull out the security type from a chosen row. Previously read a $bssid
# variable it never actually took as a parameter (relying on the caller's
# local happening to still be in scope) - takes the row directly instead.
get_security() {
    local row
    local security_loc
    local selected_security

    row=$1

    get_column_location "SECURITY"
    security_loc=$?
    # Was stripping the leading marker/space *before* the FIELDWIDTHS
    # split - that shifts every column boundary left by one character,
    # desyncing the whole row. Confirmed live: returned empty for the
    # active AP's row. Extract first, same as get_ssid, then clean up.
    selected_security=$(echo "$row" \
        | awk -v FIELDWIDTHS="$WIDTHS" "{print \$$security_loc}" \
        | sed 's/^\*//;s/^ *//;s/ *$//' \
    )
    echo $selected_security
}


# Checks if WiFi is enabled
power_on() {
    if nmcli --fields WIFI g | grep -q "enabled"; then
        return 0
    else
        return 1
    fi
}

# Toggles power state
toggle_power() {
    if power_on; then
        nmcli radio wifi off
        show_menu
    else
        if rfkill list wifi | grep -q 'blocked: yes'; then
            rfkill unblock wifi && sleep 3
        fi
        nmcli radio wifi on
        show_menu
    fi
}


# Create manual connection
create_manual_connection() {
    local connections
    local matches
    local password

    SSID=$($dmenu_command "Enter the SSID: " )
    if [ -z "$SSID" ];then
        exit 1
    fi

    # Pull a list of already created connections
    connections=$(nmcli con show)

    # Check if the connection already exists
    matches=$(echo "$connections" \
        | tail -n +2 \
        | awk '{print $1}' \
        | grep -x "$SSID"
    )

    # If so, connect to that connection
    if [[ -n "$matches" ]]; then
        echo "Connection matches $matches"
        OUT=$(nmcli con up "$SSID" 2>&1)

    # Otherwise get the password and create the connection
    else
        password=$($dmenu_command "Password: " -password)
        if [ "$password" = "" ];then
            OUT=$(nmcli dev wifi con "$SSID" 2>&1)
        else
            OUT=$(nmcli dev wifi con "$SSID" password "$password" 2>&1)
        fi
    fi
}


# Create an 802.1X connection containing username/password
create_8021x_connection() {
    local wlan
    local n_matches
    local wlan_sel
    local does_match
    local wlan
    local username
    local password

    # Get the wifi device
    wlan=$(nmcli dev \
        | grep wifi \
        | awk '{print $1}'
    )

    # Check if there's more than one WLAN device
    n_matches=$(echo -e "$wlan" | wc -l)

    # if so, let the user pick
    if [[ "$n_matches" -gt "1" ]]; then
        wlan_sel=$(echo -e "$wlan" | $dmenu_command "ifname: ")
        [[ -z "$wlan_sel" ]] && exit 1
        does_match=$(echo -e "$wlan_sel" | grep "$wlan")
        [[ -n "$wlan_sel" ]] && [[ -z "$does_match" ]] && exit 1
        wlan="$wlan_sel"
    fi

    # Get the username and password
    username=$($dmenu_command "Identity: ")

    # Go back if the username or password is blank
    if [[ "$username" == "" ]]; then
        show_menu
        return
    fi

    password=$($dmenu_command "Password: " -password)

    # Go back if the username or password is blank
    if [[ "$password" == "" ]]; then
        show_menu
        return
    fi

    # Create the connection
    nmcli con add type wifi \
        con-name "$SSID" \
        ifname "$wlan" \
        ssid "$SSID" \
        wifi-sec.key-mgmt wpa-eap 802-1x.eap ttls \
        802-1x.phase2-auth mschapv2 \
        802-1x.identity "$username" \
        802-1x.password "$password"

    # Connect
    OUT=$(nmcli con up "$SSID" 2>&1)
}


# Create a new connection based on a selected SSID
create_connection() {
    local row
    local selected_security
    local password

    row="$1"

    selected_security=$(get_security "$row")
    echo "Security: $selected_security"

    # 802.1x Security
    if [[ "$selected_security" == *"802.1X"* ]]; then
        echo "802.1X"
        create_8021x_connection

    # WEP or WPA
    elif [[ -n $(echo "$selected_security" | awk '/(WPA|WEP)/') ]]; then
        echo "WPA/WEP"

        # Go back if the password is blank
        password=$($dmenu_command "Password: " -password)
        if [[ "$password" == "" ]]; then
            show_menu
            return
        fi
        echo "WEP/WPA Connection: $SSID"
        OUT=$(nmcli dev wifi con "$SSID" password "$password")

    # No security
    else
        echo "No security"
        OUT=$(nmcli dev wifi con "$SSID")
    fi
}


handle_connection() {
    local row
    local selected_security
    local active_ap
    local connections

    row="$1"
    selected_security=$(get_security "$row")

    # Pull out the SSID of the AP selected
    SSID=$(get_ssid "$row")
    echo "Chosen SSID: $SSID"

    # Get the active AP
    active_ap=$(echo "$APS" | grep "^*")

    # Pull a list of already created connections
    connections=$(nmcli con show \
        | tail -n +2 \
        | awk '{print $1}'
    )

    # If the currently active AP is selected, turn it off
    if [[ "$row" == "$active_ap" ]]; then
        echo "Chosen active AP"
        nmcli con down "$SSID"

    # If we already have the connection details of the selected
    # AP, then bring up the connection
    elif echo "$connections" | grep -x "$SSID"; then
        nmcli con up "$SSID"

    # Otherwise create a new connection
    else
        echo "Creating a new connection"
        create_connection "$row"
    fi
}


# Opens a dmenu menu with current network options and where to connect
show_menu() {
    local power
    local options
    local chosen
    local chosen_ssid
    local row

    # Get menu options
    if power_on; then
        power="Power: on"

        # Options passed to dmenu
        options="$power\n$DIVIDER\n$DISPLAY_APS\n$DIVIDER\n$MANUAL\nExit"
    else
        power="Power: off"
        options="$power\nExit"
    fi

    # Open dmenu menu, read chosen option. nmcli's own column padding
    # assumes a monospace terminal - rendered in the theme's proportional
    # sans-serif font (config.rasi) the SSID/BARS/SECURITY columns drift
    # out of alignment, confirmed live. Overriding just this menu's font
    # to the Nerd Font Mono already vendored for the bar (desktop.nix)
    # makes nmcli's existing alignment render correctly instead of
    # hand-rolling column formatting to compensate for a proportional font.
    # rofi's plain -font flag is silently overridden by config.rasi's own
    # font: property (confirmed live: -font had zero visible effect, even
    # at a wildly different size) - -theme-str actually takes precedence.
    chosen="$(echo -e "$options" | $dmenu_command "WiFi: " -theme-str '* { font: "Inconsolata Nerd Font Mono 11"; }')"

    # Match chosen option to command
    case $chosen in
        "" | $DIVIDER)
            echo "No option chosen."
            ;;
        $power)
            toggle_power
            ;;
        $MANUAL)
            create_manual_connection
            ;;
        *)
            # $chosen is one of $DISPLAY_APS's own lines verbatim if a
            # device was selected (rofi returns back exactly what it was
            # given), not $APS's - get_ssid only reads field 1 (SSID),
            # and DISPLAY_APS's printf leaves that field's characters
            # untouched from the original row, so it still comes out
            # right even though the rest of the line (security column
            # replaced by the lock/unlock icon) no longer matches $APS's
            # layout. Map back to the real $APS row by SSID before
            # handing off - handle_connection needs the actual security
            # type (WPA/WEP/802.1X/open), not the display icon.
            chosen_ssid=$(get_ssid "$chosen")
            if [[ -n "$chosen_ssid" ]]; then
                row=$(echo "$APS" | while IFS= read -r candidate; do
                    if [[ "$(get_ssid "$candidate")" == "$chosen_ssid" ]]; then
                        echo "$candidate"
                        break
                    fi
                done)
                if [[ -n "$row" ]]; then
                    handle_connection "$row"
                fi
            fi
            ;;
    esac
    notify_error
}

# Was fuzzel, which looked out of place once every other prompt in this
# setup (pinentry-rofi, rofi-pass, rofi-bluetooth) switched to the shared
# Gruvbox rofi theme - this picks it up automatically like they do. The
# password prompts above were updated to rofi's actual -password flag
# (single dash, not fuzzel's --password) to match.
dmenu_command="rofi -dmenu -p "

show_menu

