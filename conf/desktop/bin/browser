#!/bin/sh
# Was the custom fzf-in-kitty `dmenu` tool (hardcoded #242828 background/
# border, its own font and layout) - visually inconsistent with every other
# picker in this setup (dmenu-nmcli, rofi-pass, rofi-bluetooth,
# pinentry-rofi), which all use rofi and pick up the shared Gruvbox theme
# (conf/desktop/rofi/config.rasi) automatically with no -theme flag needed.
# Matches that pattern instead of trying to reskin a different UI paradigm.

menu=$(echo -e "vivaldi\ncopy to clipboard\nplay" | rofi -dmenu -p browser)

case $menu in
    "vivaldi")
        # was vivaldi-stable - that's upstream's Debian/RPM package name,
        # not the binary nixpkgs actually installs (confirmed live: only
        # `vivaldi` exists on PATH here). Silent failure since this runs
        # backgrounded with no attached terminal to show "command not found" on.
        vivaldi "$@" &
        ;;
    "copy to clipboard")
        echo "$@" | wl-copy
        ;;
    "play")
        mpv "$@" &
        ;;
esac
