/*
 * Gruvbox Dark theme - same palette as conf/desktop/etc/xdg/kitty/kitty.conf,
 * so rofi-based prompts (pinentry-rofi, rofi-bluetooth) match the rest of the
 * desktop instead of rofi's stock default theme.
 */
* {
    bg0:    #1d2021;
    bg1:    #282828;
    bg2:    #3c3836;
    fg0:    #ebdbb2;
    fg1:    #d5c4a1;
    gray:   #928374;
    border-gray: #a89984;
    red:    #fb4934;
    yellow: #fabd2f;

    background-color: transparent;
    text-color:       @fg0;
    font:              "sans-serif 11";
}

window {
    background-color: @bg0;
    border:            2px;
    border-color:      @border-gray;
    border-radius:     4px;
    padding:           10px;
    width:             30%;
}

mainbox {
    background-color: transparent;
    children:          [ "inputbar", "message", "listview" ];
    spacing:            10px;
}

inputbar {
    background-color: @bg1;
    text-color:        @fg0;
    padding:            8px;
    border-radius:      4px;
    children:           [ "prompt", "entry" ];
}

prompt {
    text-color: @yellow;
    padding:    0px 8px 0px 0px;
}

entry {
    placeholder-color: @gray;
    text-color:        @fg0;
}

message {
    background-color: @bg1;
    text-color:        @fg1;
    padding:            8px;
    border-radius:      4px;
}

textbox {
    text-color: @fg1;
}

listview {
    background-color: transparent;
    border:            0px;
    lines:              8;
    spacing:             4px;
    cycle:                true;
    dynamic:              true;
    scrollbar:            true;
}

scrollbar {
    background-color: @bg1;
    handle-color:      @gray;
    handle-width:       6px;
    border-radius:      4px;
}

/* rofi's element state is two compound classes (row-parity x semantic
 * type) joined by a dot - a bare "element"/"element selected" selector
 * only covers what it names, anything else (alternate rows, and normal's
 * .normal/.urgent/.active split) silently falls back to rofi's own
 * compiled-in defaults instead of inheriting these. Confirmed live: with
 * only the bare selectors, unselected rows rendered with a stock cream
 * background nowhere in this palette. Covering every combination
 * explicitly instead of relying on cascade/inheritance across them.
 */
element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:        @fg1;
    padding:            6px 8px;
    border-radius:      4px;
}

element normal.urgent, element alternate.urgent,
element normal.active, element alternate.active {
    background-color: transparent;
    text-color:        @red;
    padding:            6px 8px;
    border-radius:      4px;
}

element selected.normal, element selected.urgent, element selected.active {
    background-color: @bg2;
    text-color:        @yellow;
    padding:            6px 8px;
    border-radius:      4px;
}

element-text {
    background-color: inherit;
    text-color:        inherit;
    vertical-align:    0.5;
}

error-message {
    background-color: @bg0;
    text-color:        @red;
    border:            2px;
    border-color:      @red;
    padding:           10px;
}
